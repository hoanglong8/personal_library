NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# service_role key (Project Settings -> API) — bypasses RLS. Required for:
# admin Route Handlers that write to `books`, AI job workers, and the
# one-time scripts/migrate-portal-json-to-supabase.mjs script. Never
# prefix this with NEXT_PUBLIC_ (would ship it to every browser), never
# commit the real value, never paste it into chat/logs.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Generative Language API (Gemini) — AI job queue (Giai đoạn 2):
# summarize/tag/classify/translate. Lấy tại aistudio.google.com.
GEMINI_API_KEY=your-gemini-api-key

# Service Account đọc Google Drive (Giai đoạn 2, job "ingest"). Email +
# private_key lấy trong file JSON key tải về từ Google Cloud Console (IAM
# & Admin -> Service Accounts -> Keys -> Add Key -> JSON) — dán nguyên giá
# trị private_key (giữ chuỗi \n, không phải xuống dòng thật) vào đây, đặt
# trong dấu ngoặc kép. KHÔNG đặt cả file JSON trực tiếp vào biến môi
# trường, không commit giá trị thật.
GOOGLE_SA_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_INGEST_FOLDER_URL=https://drive.google.com/drive/folders/your-folder-id

# Email được coi là admin (truy cập /admin) — kiểm tra ở server bằng
# session.user.email, không chỉ "có đăng nhập" (độc giả thường cũng có
# session từ Giai đoạn 1).
ADMIN_EMAIL=you@example.com
